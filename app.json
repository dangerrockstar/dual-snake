{
  "expo": {
    "name": "Dual Snake",
    "slug": "dual-snake",
    "version": "1.0.0",
    "scheme": "dualsnake",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dualsnake.game",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.dualsnake.game",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#101810",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101810",
          "image": "./assets/icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ff51b9f-351b-4812-b01e-b40ff54e3f38"
      }
    }
  }
}
