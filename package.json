{
  "name": "dual-snake",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit -p tsconfig.test.json && node --experimental-strip-types --test src/game.test.ts",
    "build:preview": "npx eas-cli@latest build --profile preview --platform all",
    "build:production": "npx eas-cli@latest build --profile production --platform all"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-splash-screen": "~57.0.10",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
